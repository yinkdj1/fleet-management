# Backend Environment Variables
# Copy this file to .env and fill in the actual values

# Server Configuration
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/fleet_management

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# AI Chat (Claude Anthropic)
# Sign up at: https://console.anthropic.com/
# Get your API key from the dashboard
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Frontend Base URL (for CORS and redirects)
# IMPORTANT: This URL is used in booking confirmation emails for modify/cancel links
# Make sure this points to your frontend application, NOT the admin login page
# Use FRONTEND_BASE_URL_PROD for production, FRONTEND_BASE_URL_NONPROD for staging/testing
# The system will automatically use the appropriate URL based on NODE_ENV

# Production Frontend URL
FRONTEND_BASE_URL_PROD=https://www.carsgidi.com

# Non-Production Frontend URL (staging/testing)
FRONTEND_BASE_URL_NONPROD=https://www.fleet-management-b5xnq3psj-yinkdj1s-projects.vercel.app

# Development Frontend URL
FRONTEND_BASE_URL_DEV=http://localhost:3000

# Twilio SMS Configuration (optional)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890
SUPPORT_PHONE=+1234567890

# Twilio Webhooks (optional)
RESERVATION_SMS_WEBHOOK_URL=https://your-domain.com/api/webhooks/reservation-sms
PRECHECKOUT_SMS_WEBHOOK_URL=https://your-domain.com/api/webhooks/precheckout-sms

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Pre-checkout Auto Scheduler (optional)
PRECHECKOUT_AUTO_ENABLED=true
PRECHECKOUT_AUTO_INTERVAL_MINUTES=15

# Payment Gateway Configuration
# Options: "dummy" (for testing) or "stripe" (for production)
PAYMENT_PROVIDER=dummy

# Stripe Payment Configuration (required if PAYMENT_PROVIDER=stripe)
# Sign up at: https://stripe.com/
# Get your keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Stripe Identity Verification (optional)
# Get webhook secret from: https://dashboard.stripe.com/webhooks
STRIPE_IDENTITY_WEBHOOK_SECRET=whsec_your_webhook_secret_here
